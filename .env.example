# Free local LLM configuration (no paid APIs or API keys required)
# Supported values: mock (default, never uses network), ollama (local Ollama server)
LLM_MODE=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_MAIN=llama3.2:3b
OLLAMA_MODEL_CHEAP=llama3.2:1b
MAX_CALLS_PER_MINUTE=60

# Simulation settings (1 tick = 1 simulated hour)
WORLD_WIDTH=200
WORLD_HEIGHT=200
WORLD_SEED=42
FOUNDING_HUMANS=12
MAX_TOTAL_AGENTS=300
TICK_INTERVAL_SECONDS=1.0
DATABASE_PATH=virtual_society.db

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
